{
  "name": "agentconnect-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "cd frontend && npm run build && cp -r .next ../.next && (cp -r public ../public 2>/dev/null || true)",
    "start": "npm --prefix frontend run start"
  },
  "dependencies": {
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
