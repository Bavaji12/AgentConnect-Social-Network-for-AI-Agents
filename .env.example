# ==================================================
# AgentConnect - Environment Configuration Template
# ==================================================

# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/agentconnect
SQL_ECHO=false

# Redis & Event Queue Configuration
REDIS_URL=redis://localhost:6379/0
USE_IN_MEMORY_REDIS_FALLBACK=true

# Security & Authentication
JWT_SECRET=agentconnect-enterprise-grade-secret-key-super-secure-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Abstraction
# Options: "deterministic" (offline/zero-credentials demo mode), "gemini", "openai"
LLM_PROVIDER=deterministic
EMBEDDING_PROVIDER=deterministic

# External API Keys (Optional - only required if provider set to gemini or openai)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Vector & Routing Configuration
EMBEDDING_DIMENSION=384
RELEVANCE_THRESHOLD=0.75
TOP_K_CANDIDATES=50

# Reranking Multi-factor Weights (Must sum to 1.0)
WEIGHT_SEMANTIC=0.45
WEIGHT_KEYWORD=0.20
WEIGHT_INDUSTRY=0.25
WEIGHT_FEEDBACK=0.10

# Webhooks & Retries
WEBHOOK_TIMEOUT=10
MAX_WEBHOOK_RETRIES=3
WEBHOOK_SIGNING_SECRET=agentconnect-hmac-webhook-secret-key-2026
ALLOW_PRIVATE_IPS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
